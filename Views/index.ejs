

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <h1 class="text-3xl tracking-tighter mb-9">Create User</h1>
    
        <form action="/create" method="POST" class="flex flex-col w-80">
    <input
      class="px-5 py-3 border-2 border-zinc-800 bg-transparent rounded-lg mb-4"
      type="text"
      name="name"
      placeholder="name"
    >

    <input
      class="px-5 py-3 border-2 border-zinc-800 bg-transparent rounded-lg mb-4"
      type="email"
      name="email"
      placeholder="email"
    >

    <input
      class="px-5 py-3 border-2 border-zinc-800 bg-transparent rounded-lg mb-4"
      type="text"
      name="image"
      placeholder="image url"
    >

    <input
      class="px-5 py-2 bg-blue-500 rounded-lg w-fit"
      type="submit"
      value="Create User"
    >
</form>

    </div>
</body>
</html>