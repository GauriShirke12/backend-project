<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <a href="/" class="text-blue-500">Go Back</a>
        <h1 class="text-3xl tracking-tighter mb-9">All Users</h1>
         <div class="users flex gap-3 flex-wrap">
            <% if(users.length >0 ){ %>
           <% users.forEach(function(user){ %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-52 rounded-lg bg-zinc-700">
                        <img class="w-full h-full object-cover rounded-lg" src="<%= user.image %>" alt="">
                    </div>
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                   <h5 class="text-zinc-500"><%= user.email %></h5>
                   <div>
                    <a class="text-zinc-200 mb-3" href="/edit/<%= user._id %>">Edit User</a>
                    <a class="text-red-500 ml-3" href="/delete/<%= user._id %>">Delete User</a>
                   </div>
                </div>
           <% }); %>
         </div>
         <% } else { %>
            <h3 class="text-xl">No Users Found</h3>
         <% } %>
    </div>
</body>
</html>